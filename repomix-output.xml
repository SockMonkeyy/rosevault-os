  return (
    <section className="rounded-2xl border border-[#EDE7DC] bg-white/45 p-6 backdrop-blur-sm transition-all duration-300 hover:border-[#D8B66A]/30">
      <div className="mb-6">
        <h2 className="font-serif text-xl font-normal text-[#B7832F]">
          {title}
        </h2>

        <p className="mt-1 text-sm text-[#8F8578]">
