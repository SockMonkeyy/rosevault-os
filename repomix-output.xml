          <span className="font-semibold text-[#B7832F]">{percent}%</span>
        </div>

        <div className="h-2 overflow-hidden rounded-full bg-[#ECE6DB]">
          <div
            className="h-full rounded-full bg-[#B7832F] transition-all duration-500"
