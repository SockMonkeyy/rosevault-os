  const docCount = documents?.length ?? 0;
  const noteCount = notes?.length ?? 0;
  const activityCount = activity?.length ?? 0;

  return (
    <div className="mx-auto max-w-7xl space-y-8 px-4 py-8 sm:px-6 lg:px-8">
      {/* 1. Header Section */}
      <div className="space-y-4">
