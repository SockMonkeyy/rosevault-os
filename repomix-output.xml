            >
              {isDeleting ? "Deleting Property..." : "Delete Property"}
            </button>
          </section>

          {/* Save error */}
          {errorMessage && (
            <div className="rounded-xl border border-red-200 bg-red-50/70 px-5 py-4 text-sm text-red-700 backdrop-blur-sm">
