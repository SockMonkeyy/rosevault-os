              <p className="mt-1 font-medium text-[#29231D]">{nextStage}</p>
            </div>

            <ArrowRight className="h-5 w-5 text-[#B7832F]" />
          </div>
        </>
      )}

      {remainingTasks.length > 0 && (
        <>
          <div className="my-6 border-t border-[#ECE6DB]" />

